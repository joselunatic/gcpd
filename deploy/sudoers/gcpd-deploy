# Install with visudo. This policy is intentionally bound to the deploy user.
#
# Example:
#   sudo install -m 0440 deploy/sudoers/gcpd-deploy /etc/sudoers.d/gcpd-deploy
#
# This grants only the commands needed by scripts/deploy-prod.sh.

Defaults:deploy !requiretty

Cmnd_Alias GCPD_SYNC = /usr/bin/install -d -o gcpd -g gcpd /opt/gcpd, \
  /usr/bin/rsync -a --delete --exclude .git --exclude .github --exclude .gitignore --exclude node_modules --exclude .codex --exclude .DS_Store --exclude var --exclude server/batconsole.db --exclude public/assets --exclude public/uploads * /opt/gcpd/, \
  /usr/bin/chown -R gcpd\:gcpd /opt/gcpd, \
  /usr/bin/rm -rf /opt/gcpd/node_modules, \
  /usr/bin/rm -rf /opt/gcpd/.tmp

Cmnd_Alias GCPD_BUILD = /usr/local/bin/gcpd-npm *

Cmnd_Alias GCPD_RESTART = /usr/bin/systemctl restart gcpd-api gcpd-frontend, \
  /usr/bin/systemctl status gcpd-api gcpd-frontend

deploy ALL=(root) NOPASSWD: GCPD_SYNC, GCPD_RESTART
deploy ALL=(gcpd) NOPASSWD: GCPD_BUILD
