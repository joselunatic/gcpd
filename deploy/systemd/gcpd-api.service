[Unit]
Description=GCPD Brother Eye API
After=network.target

[Service]
Type=simple
User=gcpd
Group=gcpd
WorkingDirectory=/opt/gcpd
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
Environment=PORT=4000
Environment=GCPD_DATA_DIR=/var/lib/gcpd
Environment=GCPD_REQUIRE_DM_PASSWORD=1
EnvironmentFile=-/etc/gcpd/gcpd.env
ExecStart=/usr/local/bin/gcpd-npm --prefix /opt/gcpd run server
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gcpd-api
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
StateDirectory=gcpd
ReadWritePaths=/var/lib/gcpd
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
