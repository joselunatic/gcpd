# Install as /etc/gcpd/gcpd.env (owner root:gcpd, mode 0640).
# Generate unique values; never commit the real file.
DM_DEFAULT_PASSWORD=replace-with-a-long-random-password
# Optional emergency/test access. Use a different long random value.
DM_BACKDOOR_PASSWORD=replace-with-a-separate-long-random-password
DM_SESSION_DURATION_MS=21600000
